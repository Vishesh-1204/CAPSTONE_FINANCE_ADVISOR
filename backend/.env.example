DATABASE_URL=postgresql://finance_user:finance_pass@db:5432/finance_db
SECRET_KEY=replace-this-with-a-random-secret
ENVIRONMENT=development

LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.0

GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=your_actual_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional second provider, tried when the primary fails (gemini | openai). Empty = none.
LLM_FALLBACK_PROVIDER=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Categorizer switches (ablations for the paper). Defaults shown.
# CATEGORIZER_ENABLE_MEMORY=true
# CATEGORIZER_ENABLE_RULES=true
# CATEGORIZER_ENABLE_PAYEE_RULES=true
# CATEGORIZER_ENABLE_PERSON_GUARD=true

# Budget planner tuning (Phase 4). Defaults shown.
# BUDGET_LOOKBACK_MONTHS=3
# BUDGET_DISCRETIONARY_TRIM=0.10
# BUDGET_WARNING_THRESHOLD=0.80
# BUDGET_GUARD_TOLERANCE=1.0
# BUDGET_USE_LLM_EXPLANATIONS=true

# Forecast agent tuning (Phase 5). Defaults shown.
# FORECAST_INTERVAL_COVERAGE=0.8
# FORECAST_MIN_HISTORY_MONTHS=1
# FORECAST_RECURRING_MIN_OCCURRENCES=3
# FORECAST_RECURRING_AMOUNT_TOLERANCE=0.15
# FORECAST_RECURRING_STALE_DAYS=45
# FORECAST_FALLBACK_INTERVAL_WIDTH=0.25
# FORECAST_MIN_BACKTEST_FOLDS=2
# FORECAST_MIN_INTERVAL_ERRORS=3
# FORECAST_USE_LLM_EXPLANATIONS=true

# Investment advisor (Phase 6). Defaults shown.
# The return/volatility values are ILLUSTRATIVE PLACEHOLDERS, not market data:
# replace them with figures from a cited source before publishing any results.
# INVEST_EQUITY_RETURN=0.11
# INVEST_EQUITY_VOL=0.17
# INVEST_DEBT_RETURN=0.06
# INVEST_DEBT_VOL=0.04
# INVEST_GOLD_RETURN=0.07
# INVEST_GOLD_VOL=0.14
# INVEST_CASH_RETURN=0.035
# INVEST_CASH_VOL=0.005
# INVEST_SIP_SAFETY_FACTOR=0.8
# INVEST_MC_PATHS=2000
# INVEST_MC_SEED=42
# INVEST_EMERGENCY_TARGET_MONTHS=6
# INVEST_EMERGENCY_FILL_MONTHS=12
# INVEST_FORECAST_MAX_AGE_DAYS=31
# INVEST_USE_LLM_EXPLANATIONS=true
