DATABASE_URL=postgresql://finance_user:finance_pass@db:5432/finance_db
SECRET_KEY=replace-this-with-a-random-secret
ENVIRONMENT=development

LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.0

GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=your_actual_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional second provider, tried when the primary fails (gemini | openai). Empty = none.
LLM_FALLBACK_PROVIDER=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Categorizer switches (ablations for the paper). Defaults shown.
# CATEGORIZER_ENABLE_MEMORY=true
# CATEGORIZER_ENABLE_RULES=true
# CATEGORIZER_ENABLE_PAYEE_RULES=true
# CATEGORIZER_ENABLE_PERSON_GUARD=true

# Budget planner tuning (Phase 4). Defaults shown.
# BUDGET_LOOKBACK_MONTHS=3
# BUDGET_DISCRETIONARY_TRIM=0.10
# BUDGET_WARNING_THRESHOLD=0.80
# BUDGET_GUARD_TOLERANCE=1.0
# BUDGET_USE_LLM_EXPLANATIONS=true

# Forecast agent tuning (Phase 5). Defaults shown.
# FORECAST_INTERVAL_COVERAGE=0.8
# FORECAST_MIN_HISTORY_MONTHS=1
# FORECAST_RECURRING_MIN_OCCURRENCES=3
# FORECAST_RECURRING_AMOUNT_TOLERANCE=0.15
# FORECAST_RECURRING_STALE_DAYS=45
# FORECAST_FALLBACK_INTERVAL_WIDTH=0.25
# FORECAST_MIN_BACKTEST_FOLDS=2
# FORECAST_MIN_INTERVAL_ERRORS=3
# FORECAST_USE_LLM_EXPLANATIONS=true

# Investment advisor (Phase 6). Defaults shown.
# The return/volatility values are ILLUSTRATIVE PLACEHOLDERS, not market data:
# replace them with figures from a cited source before publishing any results.
# INVEST_EQUITY_RETURN=0.11
# INVEST_EQUITY_VOL=0.17
# INVEST_DEBT_RETURN=0.06
# INVEST_DEBT_VOL=0.04
# INVEST_GOLD_RETURN=0.07
# INVEST_GOLD_VOL=0.14
# INVEST_CASH_RETURN=0.035
# INVEST_CASH_VOL=0.005
# INVEST_SIP_SAFETY_FACTOR=0.8
# INVEST_MC_PATHS=2000
# INVEST_MC_SEED=42
# INVEST_EMERGENCY_TARGET_MONTHS=6
# INVEST_EMERGENCY_FILL_MONTHS=12
# INVEST_FORECAST_MAX_AGE_DAYS=31
# INVEST_USE_LLM_EXPLANATIONS=true

# Stock intelligence (Phase 7). Defaults shown. See docs/phase7-provider-spike.md.
# Prices: yfinance is the only adapter built (Alpha Vantage's free tier gives 100 bars only,
# so ALPHAVANTAGE_API_KEY is NOT used by the app).
# MARKET_DATA_PROVIDER=yfinance
# Headlines: google_rss (recommended, standard library) or yfinance (max 10 per stock)
# NEWS_PROVIDER=google_rss
# Use cached prices/news younger than this many hours without calling the provider
# STOCK_CACHE_TTL_HOURS=24
# Max symbols per user's watchlist
# STOCK_WATCHLIST_LIMIT=10
# Calendar days of history fetched per refresh (10 years)
# STOCK_HISTORY_DAYS=3650
# Benchmark index for beta / correlation (Nifty 50)
# STOCK_BENCHMARK_SYMBOL=^NSEI
# After a rate limit / outage, do not call the provider for this many minutes (stale cache instead)
# STOCK_PROVIDER_COOLDOWN_MINUTES=15
# Each failure in a row doubles the cooldown, up to this many minutes (= the line above: constant cooldown)
# STOCK_PROVIDER_COOLDOWN_MAX_MINUTES=240
# Ablation switch: false = template explanations only, no LLM call
# STOCK_USE_LLM_EXPLANATIONS=true

# Headline sentiment (Phase 7A-4). lexicon (default) | finbert.
# finbert needs the optional ML image: docker compose --profile ml up --build  (port 8001,
# which sets SENTIMENT_SCORER=finbert itself). Unavailable -> lexicon + "finbert_unavailable".
# SENTIMENT_SCORER=lexicon
# FINBERT_MODEL_NAME=ProsusAI/finbert
# FINBERT_MODEL_REVISION=0bc2ac10dda6929bcb1f77ccc43c7ec5c424f031   (pinned commit; licence CC BY-NC-SA 4.0)
# FINBERT_BATCH_SIZE=16
